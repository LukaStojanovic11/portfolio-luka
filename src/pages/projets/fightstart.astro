---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import Scene from '../../components/Scene.astro';
import Laptop from '../../components/Laptop.astro';
import Frame from '../../components/Frame.astro';
import Crop from '../../components/Crop.astro';

const pillars = [
  ['Protection totale', 'Équipements sélectionnés et certifiés.'],
  ['Expédition rapide', 'Livraison depuis un stock suisse à Yverdon-les-Bains.'],
  ['Budget maîtrisé', 'Des packs et produits essentiels accessibles aux débutants.'],
];
---

<ProjectLayout
  title="FightStart.ch"
  description="Boutique en ligne de matériel de sport de combat pour débutants, de la stratégie à la mise en ligne."
  tags={['E-commerce', 'WordPress', 'Stratégie digitale']}
  meta={[
    { label: 'Rôle', value: 'UX/UI + Direction artistique' },
    { label: 'Année', value: 'Projet étudiant' },
    { label: 'Stack', value: 'WordPress / Elementor' },
  ]}
  externalLink={{ label: 'Voir le site', url: 'https://fightstart.ch/' }}
>
  <section class="section--flush">
    <Scene class="hero-scene" lit>
      <Laptop
        src="/images/projects/fightstart/screenshot-home-hero.jpg"
        alt="Homepage complète de FightStart"
        duration="10s"
      />
      <p class="hero-scene__hint">Survolez pour parcourir ↓</p>
      <p class="hero-scene__caption">Fig. 01 — Accueil</p>
      <p class="hero-scene__meta">fightstart.ch</p>
    </Scene>
  </section>

  <section>
    <div class="container claim-grid">
      <span class="eyebrow">01 — Le défi</span>
      <div>
        <h2 class="claim">
          Faire entrer les débutants sur le ring <span style="color: var(--color-accent);">sans les intimider.</span>
        </h2>
        <p class="claim-support">
          Boutique e-commerce fictive conçue pour un projet d'étude HEIG-VD :
          une marque, un catalogue et une expérience d'achat pensés de A à Z.
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <Frame
        src="/images/projects/fightstart/screenshot-shop.webp"
        alt="Boutique FightStart — catalogue complet"
        url="fightstart.ch/shop"
        duration="10s"
      />
      <p class="frame-caption">
        <span>Fig. 02 — Catalogue · 30 produits</span><span>Survolez pour parcourir ↓</span>
      </p>
    </div>
  </section>

  <section class="section--coal">
    <div class="container">
      <div class="claim-grid">
        <span class="eyebrow">02 — Positionnement</span>
        <h2 class="claim">Rassurer avant de <span style="color: var(--color-accent);">vendre.</span></h2>
      </div>
      <div class="rule" style="margin-top: 3rem; height: 1px; background: var(--color-border);"></div>
      <div class="pillars">
        {pillars.map(([t, d], i) => (
          <div class="pillar reveal" style={`transition-delay: ${i * 120}ms;`}>
            <span class="pillar__num">0{i + 1}</span>
            <h3>{t}</h3>
            <p>{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <Scene class="hero-scene" style="height: clamp(380px, 55vh, 640px);">
      <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: flex-end; padding-right: 6%;">
        <Laptop
          src="/images/projects/fightstart/screenshot-about.webp"
          alt="Page À propos de FightStart"
          angle={-18}
          width="min(52vw, 860px)"
        />
      </div>
      <div class="hero-scene__quote">
        <p class="eyebrow">Fig. 03</p>
        <p class="hero-scene__quote-text">Une marque,<br />pas un template.</p>
      </div>
    </Scene>

    <div class="container" style="margin-top: 3rem;">
      <div class="two-col" style="align-items: start;">
        <Frame
          src="/images/projects/fightstart/screenshot-contact.webp"
          alt="Page contact FightStart"
          url="fightstart.ch/contact"
        />
        <Frame
          src="/images/projects/fightstart/screenshot-faq.webp"
          alt="Page FAQ FightStart"
          url="fightstart.ch/faq"
          class="frame--offset"
        />
      </div>
    </div>

    <div class="container" style="margin-top: 3rem;">
      <div class="crop-row">
        <Crop
          src="/images/projects/fightstart/screenshot-home-hero.jpg"
          x={26}
          y={80}
          zoom={4.5}
          label="CTA primaire"
        />
        <Crop
          src="/images/projects/fightstart/screenshot-product.jpg"
          x={38}
          y={78}
          zoom={7}
          label="Détail produit"
        />
        <figure class="crop reveal">
          <div class="crop__frame">
            <img
              src="/images/projects/fightstart/screenshot-home.webp"
              alt="Identité de marque FightStart"
              loading="lazy"
              style="width: 100%; height: 100%; object-fit: cover; object-position: left top;"
            />
          </div>
          <figcaption class="crop__caption">
            <span>Identité de marque</span><span class="crop__plus">+</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section>
    <div class="container claim-grid">
      <span class="eyebrow">03 — Mon rôle</span>
      <div>
        <p class="claim" style="font-size: clamp(1.75rem, 4vw, 3rem);">
          UX/UI · Direction artistique · Architecture · Contenu · <span style="color: var(--color-accent);">E-commerce</span>
        </p>
        <p class="claim-support">
          De l'arborescence à la mise en ligne sur WordPress / Elementor :
          design des interfaces, rédaction, catalogue, panier et widget
          WhatsApp.
        </p>
      </div>
    </div>
  </section>
</ProjectLayout>

<style>
  .frame-caption {
    margin-top: 1.1rem;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-ash);
  }

  .section--coal {
    background: #0d0d0d;
  }

  .hero-scene__quote {
    position: absolute;
    left: 4%;
    top: 50%;
    max-width: 20rem;
    transform: translateY(-50%);
  }

  .hero-scene__quote-text {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .frame--offset {
    margin-top: 0;
  }

  @media (min-width: 768px) {
    .frame--offset {
      margin-top: 3rem;
    }
  }

  .crop-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    height: auto;
  }

  .crop-row .crop {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }

  .crop-row .crop__frame {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: #fff;
  }

  .crop-row .crop__caption {
    margin-top: 0.75rem;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-ash);
  }

  .crop-row .crop__plus {
    color: var(--color-accent);
  }

  @media (min-width: 768px) {
    .crop-row {
      grid-template-columns: repeat(3, 1fr);
      height: 220px;
    }
  }
</style>
