---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<a href={`/projets/${project.slug}`} class="project-card reveal">
  <div class="project-card__media">
    <img src={project.cover} alt={project.coverAlt} loading="lazy" />
  </div>
  <div class="project-card__body">
    <span class="project-card__num">{num}</span>
    <div class="project-card__text">
      <span class="eyebrow">{project.subtitle}</span>
      <h3 class="project-card__title">{project.title}</h3>
      <p class="project-card__summary">{project.summary}</p>
      <div class="project-card__tags">
        {project.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </div>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
    transition: transform var(--transition-base), border-color var(--transition-base);
  }

  .project-card:hover {
    transform: translateY(-6px);
    border-color: var(--color-accent);
  }

  .project-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-bg-elevated-2);
  }

  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .project-card:hover .project-card__media img {
    transform: scale(1.05);
  }

  .project-card__body {
    display: flex;
    gap: 1rem;
    padding: 1.5rem;
  }

  .project-card__num {
    font-family: var(--font-display);
    font-size: 0.85rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .project-card__title {
    margin-block: 0.4rem 0.6rem;
    font-size: 1.3rem;
  }

  .project-card__summary {
    font-size: 0.92rem;
    margin-bottom: 1rem;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
