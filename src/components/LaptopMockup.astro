---
interface Props {
  src: string;
  alt: string;
  url?: string;
  objectPosition?: string;
  class?: string;
}

const { src, alt, url, objectPosition = 'top', class: className } = Astro.props;
---

<div class:list={['laptop', className]}>
  <div class="laptop__screen">
    <div class="laptop__chrome">
      <span class="laptop__dot"></span>
      <span class="laptop__dot"></span>
      <span class="laptop__dot"></span>
      {url && <div class="laptop__url">{url}</div>}
    </div>
    <div class="laptop__content">
      <img src={src} alt={alt} loading="lazy" style={`object-position: ${objectPosition};`} />
    </div>
  </div>
  <div class="laptop__hinge"></div>
  <div class="laptop__base"></div>
</div>

<style>
  .laptop {
    width: 100%;
    max-width: 720px;
    margin-inline: auto;
  }

  .laptop__screen {
    background: #0f0f0f;
    border: 1px solid #2a2a2a;
    border-radius: 14px 14px 4px 4px;
    padding: 10px 10px 0;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.55);
  }

  .laptop__chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.15rem 0.4rem 0.6rem;
  }

  .laptop__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #3a3a3a;
    flex-shrink: 0;
  }

  .laptop__dot:first-child {
    background: var(--color-accent);
  }

  .laptop__url {
    margin-left: 0.75rem;
    padding: 0.3rem 1rem;
    background: #1c1c1c;
    border-radius: 999px;
    font-size: 0.72rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  .laptop__content {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 3px 3px 0 0;
    background: var(--color-bg-elevated-2);
  }

  .laptop__content img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .laptop__hinge {
    height: 8px;
    background: linear-gradient(180deg, #1c1c1c, #0a0a0a);
    border-radius: 0 0 3px 3px;
  }

  .laptop__base {
    height: 12px;
    margin: 0 -18px;
    background: linear-gradient(180deg, #232323, #151515);
    clip-path: polygon(3% 0, 97% 0, 100% 100%, 0% 100%);
    border-radius: 0 0 8px 8px;
    position: relative;
  }

  .laptop__base::after {
    content: '';
    position: absolute;
    top: 4px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    background: #0a0a0a;
    border-radius: 2px;
  }
</style>
