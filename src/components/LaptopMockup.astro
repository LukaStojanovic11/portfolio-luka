---
interface Props {
  src: string;
  alt: string;
  url?: string;
  objectPosition?: string;
  showDeck?: boolean;
  class?: string;
}

const { src, alt, url, objectPosition = 'top', showDeck = true, class: className } = Astro.props;
---

<div class:list={['laptop', { 'laptop--no-deck': !showDeck }, className]}>
  <div class="laptop__screen">
    <div class="laptop__chrome">
      <span class="laptop__dot"></span>
      <span class="laptop__dot"></span>
      <span class="laptop__dot"></span>
      {url && <div class="laptop__url">{url}</div>}
    </div>
    <div class="laptop__content">
      <img src={src} alt={alt} loading="lazy" style={`object-position: ${objectPosition};`} />
    </div>
  </div>

  {showDeck && (
    <div class="laptop__deck">
      <div class="laptop__keys" aria-hidden="true"></div>
      <div class="laptop__trackpad" aria-hidden="true"></div>
    </div>
  )}
</div>

<style>
  .laptop {
    width: 100%;
    max-width: 720px;
    margin-inline: auto;
    position: relative;
  }

  .laptop::after {
    content: '';
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: -18px;
    height: 26px;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.7), transparent 72%);
    filter: blur(4px);
    z-index: -1;
  }

  .laptop__screen {
    background: #0c0c0c;
    border-radius: 14px 14px 3px 3px;
    padding: 8px 8px 0;
    box-shadow: 0 26px 50px rgba(0, 0, 0, 0.6);
  }

  .laptop--no-deck .laptop__screen {
    border-radius: 12px;
    padding-bottom: 8px;
  }

  .laptop--no-deck .laptop__content {
    border-radius: 3px;
  }

  .laptop__chrome {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0.1rem 0.35rem 0.5rem;
  }

  .laptop__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3a3a3a;
    flex-shrink: 0;
  }

  .laptop__dot:first-child {
    background: var(--color-accent);
  }

  .laptop__url {
    margin-left: 0.75rem;
    padding: 0.25rem 1rem;
    background: #1c1c1c;
    border-radius: 999px;
    font-size: 0.7rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  .laptop__content {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 3px 3px 0 0;
    background: var(--color-bg-elevated-2);
  }

  .laptop__content img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Socle clavier — aluminium, pour lire clairement "ordinateur portable" */
  .laptop__deck {
    background: linear-gradient(180deg, #e4e4e4 0%, #c2c2c2 55%, #aeaeae 100%);
    border-radius: 0 0 10px 10px;
    padding: 9px 8% 14px;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.5);
  }

  .laptop__keys {
    height: 28px;
    border-radius: 4px;
    background-color: #999;
    background-image: repeating-linear-gradient(
        90deg,
        rgba(120, 120, 120, 0.55) 0 5px,
        transparent 5px 9px
      ),
      repeating-linear-gradient(0deg, rgba(120, 120, 120, 0.4) 0 4px, transparent 4px 8px);
    opacity: 0.75;
  }

  .laptop__trackpad {
    width: 22%;
    min-width: 60px;
    height: 34px;
    margin: 8px auto 0;
    background: #b3b3b3;
    border-radius: 5px;
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.3);
  }
</style>
